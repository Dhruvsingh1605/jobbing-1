"""Job discovery from login-free sources. Every function returns a list of job dicts:
   {source, company, title, location, url, apply_url, ats, description, posted, email}"""
import html, re, time
from urllib.parse import urlparse, parse_qs
import requests
from bs4 import BeautifulSoup
from .core import load_yaml, db, log

UA = {"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/158.0 Safari/537.36"}
S = requests.Session(); S.headers.update(UA)

def get(url, **kw):
    try:
        r = S.get(url, timeout=kw.pop("timeout", 25), **kw)
        return r if r.status_code == 200 else None
    except Exception: return None

def text_of(h):
    if not h: return ""
    return BeautifulSoup(html.unescape(h), "lxml").get_text(" ", strip=True)

def age_days(posted):
    """Days since posting (float) or None if unknown. Handles ISO strings, epoch ms/s, RFC-2822."""
    from datetime import datetime, timezone
    if not posted: return None
    t = str(posted).strip()
    try:
        if t.isdigit():
            v = int(t); v = v / 1000 if v > 1e11 else v
            dt = datetime.fromtimestamp(v, timezone.utc)
        else:
            try: dt = datetime.fromisoformat(t.replace("Z", "+00:00"))
            except ValueError:
                from email.utils import parsedate_to_datetime; dt = parsedate_to_datetime(t)
        if dt.tzinfo is None: dt = dt.replace(tzinfo=timezone.utc)
        return max(0.0, (datetime.now(timezone.utc) - dt).total_seconds() / 86400)
    except Exception: return None

def detect_ats(url):
    u = (url or "").lower()
    for key, pats in {"greenhouse": ["greenhouse.io"], "lever": ["jobs.lever.co"], "ashby": ["ashbyhq.com"],
                      "smartrecruiters": ["smartrecruiters.com"], "workable": ["workable.com"],
                      "workday": ["myworkdayjobs.com", "workdayjobs"], "linkedin": ["linkedin.com"],
                      "naukri": ["naukri.com"], "icims": ["icims.com"], "taleo": ["taleo.net"]}.items():
        if any(p in u for p in pats): return key
    return "other"

def board_from_url(url):
    """(ats, token) for a posting URL on a supported ATS, else None."""
    try: p = urlparse(url)
    except Exception: return None
    host, parts = p.netloc.lower(), [x for x in p.path.split("/") if x]
    if "greenhouse.io" in host:
        if parts and parts[0] == "embed": 
            t = parse_qs(p.query).get("for", [None])[0]; return ("greenhouse", t) if t else None
        return ("greenhouse", parts[0]) if parts else None
    if host == "jobs.lever.co" and parts: return ("lever", parts[0])
    if host.endswith("ashbyhq.com") and parts: return ("ashby", parts[0])
    if host.endswith("smartrecruiters.com") and parts: return ("smartrecruiters", parts[0])
    if host == "apply.workable.com" and parts: return ("workable", parts[0])
    return None

def register_board(con, ats, token):
    if not ats or not token: return False
    cur = con.execute("INSERT OR IGNORE INTO seen_boards VALUES(?,?)", (ats, token)); con.commit()
    return cur.rowcount > 0

# ---------------------------------------------------------------- ATS public APIs
def fetch_board(ats, tok):
    jobs = []
    try:
        if ats == "greenhouse":
            r = get(f"https://boards-api.greenhouse.io/v1/boards/{tok}/jobs?content=true", timeout=40)
            for j in (r.json().get("jobs", []) if r else []):
                jobs.append(dict(company=j.get("company_name") or tok, title=j["title"], location=(j.get("location") or {}).get("name", ""),
                    url=j["absolute_url"], apply_url=f"https://job-boards.greenhouse.io/{tok}/jobs/{j['id']}", description=text_of(j.get("content")), posted=j.get("updated_at", "")))
        elif ats == "lever":
            r = get(f"https://api.lever.co/v0/postings/{tok}?mode=json", timeout=40)
            for j in (r.json() if r else []):
                jobs.append(dict(company=tok, title=j["text"], location=(j.get("categories") or {}).get("location", "") or "",
                    url=j["hostedUrl"], apply_url=j.get("applyUrl") or j["hostedUrl"] + "/apply",
                    description=j.get("descriptionPlain", "") + " " + " ".join(l.get("text", "") + " " + text_of(l.get("content")) for l in j.get("lists", [])),
                    posted=str(j.get("createdAt", ""))))
        elif ats == "ashby":
            r = get(f"https://api.ashbyhq.com/posting-api/job-board/{tok}?includeCompensation=true", timeout=40)
            for j in (r.json().get("jobs", []) if r else []):
                if j.get("isListed") is False: continue
                loc = j.get("location", "") + (" (Remote)" if j.get("isRemote") else "")
                jobs.append(dict(company=tok, title=j["title"], location=loc, url=j["jobUrl"], apply_url=j.get("applyUrl") or j["jobUrl"],
                    description=j.get("descriptionPlain", ""), posted=j.get("publishedAt", "")))
        elif ats == "smartrecruiters":
            r = get(f"https://api.smartrecruiters.com/v1/companies/{tok}/postings?limit=100", timeout=40)
            for j in (r.json().get("content", []) if r else []):
                l = j.get("location") or {}
                jobs.append(dict(company=(j.get("company") or {}).get("name", tok), title=j["name"],
                    location=", ".join(x for x in [l.get("city"), l.get("country", "").upper()] if x) + (" (Remote)" if l.get("remote") else ""),
                    url=f"https://jobs.smartrecruiters.com/{tok}/{j['id']}", apply_url=f"https://jobs.smartrecruiters.com/{tok}/{j['id']}",
                    description="", posted=j.get("releasedDate", "")))
        elif ats == "workable":
            r = get(f"https://apply.workable.com/api/v1/widget/accounts/{tok}?details=true", timeout=40)
            for j in (r.json().get("jobs", []) if r else []):
                jobs.append(dict(company=(r.json().get("name") or tok), title=j["title"], location=", ".join(x for x in [j.get("city"), j.get("country")] if x),
                    url=j.get("url") or j.get("shortlink"), apply_url=j.get("application_url") or j.get("url"), description=text_of(j.get("description")),
                    posted=j.get("published_on", "")))
    except Exception as e:
        log(f"board {ats}/{tok} failed: {str(e)[:80]}", "WARN")
    for j in jobs: j.update(source=f"ats:{ats}", ats=ats, email=None)
    return jobs

def ats_boards(con):
    boards = load_yaml("boards.yaml")
    todo = {(a, t) for a, ts in boards.items() for t in ts}
    todo |= {(r["ats"], r["token"]) for r in con.execute("SELECT * FROM seen_boards")}
    jobs = []
    for ats, tok in sorted(todo):
        jobs += fetch_board(ats, tok)
    log(f"ATS boards: {len(todo)} boards -> {len(jobs)} postings")
    return jobs

def fill_description(job):
    """Lazy-fetch description for sources that don't list it (SmartRecruiters)."""
    if job.get("ats") == "other" and job.get("source") == "career-page" and len(job.get("description") or "") < 600:
        r = get(job["url"])      # snippet only so far: fetch the page text so the scorer sees the real requirements
        if r:
            try: job["description"] = text_of(r.text)[:6000]
            except Exception: pass
        return job
    if job.get("description") or job.get("ats") != "smartrecruiters": return job
    m = re.search(r"smartrecruiters\.com/([^/]+)/(\d+)", job["url"])
    if m:
        r = get(f"https://api.smartrecruiters.com/v1/companies/{m.group(1)}/postings/{m.group(2)}")
        if r:
            sec = (r.json().get("jobAd") or {}).get("sections", {})
            job["description"] = " ".join(text_of(v.get("text")) for v in sec.values())
    return job

# ---------------------------------------------------------------- aggregators
def _mk(source, company, title, location, url, apply_url, desc, posted="", email=None):
    return dict(source=source, company=company or "?", title=title or "", location=location or "", url=url, apply_url=apply_url or url,
                ats=detect_ats(apply_url or url), description=desc or "", posted=str(posted or ""), email=email)

def aggregators(con):
    out = []
    def safe(name, fn):
        try: r = fn(); out.extend(r); log(f"{name}: {len(r)} postings")
        except Exception as e: log(f"{name} failed: {str(e)[:80]}", "WARN")
    def remotive():
        r = get("https://remotive.com/api/remote-jobs?category=software-dev&limit=300") or get("https://remotive.com/api/remote-jobs?search=ai")
        return [_mk("remotive", j["company_name"], j["title"], j.get("candidate_required_location"), j["url"], j["url"], text_of(j.get("description")), j.get("publication_date")) for j in (r.json()["jobs"] if r else [])]
    def arbeitnow():
        res = []
        for page in (1, 2, 3):
            r = get(f"https://www.arbeitnow.com/api/job-board-api?page={page}")
            for j in (r.json().get("data", []) if r else []):
                res.append(_mk("arbeitnow", j["company_name"], j["title"], j.get("location") + (" (Remote)" if j.get("remote") else ""), j["url"], j["url"], text_of(j.get("description")) + " visa sponsorship relocation" if "visa sponsorship" in " ".join(j.get("tags", [])).lower() else text_of(j.get("description")), j.get("created_at")))
        return res
    def remoteok():
        r = get("https://remoteok.com/api")
        return [_mk("remoteok", j.get("company"), j.get("position"), j.get("location") or "Remote", j["url"], j.get("apply_url") or j["url"], text_of(j.get("description")), j.get("date")) for j in (r.json()[1:] if r else []) if j.get("position")]
    def himalayas():
        res = []
        for off in (0, 20, 40, 60, 80):
            r = get(f"https://himalayas.app/jobs/api?limit=20&offset={off}")
            for j in (r.json().get("jobs", []) if r else []):
                loc = ", ".join(j.get("locationRestrictions") or []) or "Remote (worldwide)"
                res.append(_mk("himalayas", j.get("companyName"), j.get("title"), loc, j.get("applicationLink") or j.get("guid"), j.get("applicationLink"), text_of(j.get("description") or j.get("excerpt")), j.get("pubDate")))
        return res
    def jobicy():
        r = get("https://jobicy.com/api/v2/remote-jobs?count=50&tag=ai") 
        res = [_mk("jobicy", j["companyName"], j["jobTitle"], j.get("jobGeo"), j["url"], j["url"], text_of(j.get("jobDescription")), j.get("pubDate")) for j in (r.json().get("jobs", []) if r else [])]
        r = get("https://jobicy.com/api/v2/remote-jobs?count=50&tag=python")
        res += [_mk("jobicy", j["companyName"], j["jobTitle"], j.get("jobGeo"), j["url"], j["url"], text_of(j.get("jobDescription")), j.get("pubDate")) for j in (r.json().get("jobs", []) if r else [])]
        return res
    def hn():
        r = get("https://hn.algolia.com/api/v1/search_by_date?query=%22who%20is%20hiring%22&tags=story,author_whoishiring&hitsPerPage=3")
        story = next((h for h in (r.json()["hits"] if r else []) if "who is hiring" in h["title"].lower()), None)
        if not story: return []
        sid = story["objectID"]; kids = []
        for q in ("AI", "LLM", "machine learning", "python"):
            r = get(f"https://hn.algolia.com/api/v1/search?query={q.replace(' ', '%20')}&tags=comment,story_{sid}&hitsPerPage=200", timeout=40)
            kids += [h for h in (r.json().get("hits", []) if r else []) if str(h.get("parent_id")) == str(sid)]
        res = []; seen_ids = set()
        for c in kids:
            if c["objectID"] in seen_ids: continue
            seen_ids.add(c["objectID"]); c["id"] = c["objectID"]; c["text"] = c.get("comment_text")
            t = text_of(c.get("text") or "")
            if not t: continue
            head = t.split(" | ")
            company = head[0][:60]; title = head[1][:100] if len(head) > 1 else "Engineer"
            urls = re.findall(r"https?://[^\s)\]>\"']+", c.get("text") or "")
            urls = [html.unescape(u) for u in urls]
            mail = re.search(r"[\w.+-]+@[\w-]+\.[\w.-]+", t)
            link = next((u for u in urls if detect_ats(u) != "other"), None) or (urls[0] if urls else f"https://news.ycombinator.com/item?id={c['id']}")
            res.append(_mk("hn", company, title, t[:200], f"https://news.ycombinator.com/item?id={c['id']}", link, t, c.get("created_at"), mail.group(0) if mail else None))
        return res
    for n, f in [("remotive", remotive), ("arbeitnow", arbeitnow), ("remoteok", remoteok), ("himalayas", himalayas), ("jobicy", jobicy), ("hn-whoishiring", hn)]:
        safe(n, f)
    # any ATS links inside aggregator results -> grow our board list (so future runs query the full board via its API)
    new = 0
    for j in out:
        b = board_from_url(j["apply_url"] or "")
        if b and register_board(con, *b): new += 1
    if new: log(f"discovered {new} new ATS boards from aggregator links")
    return out


# ---------------------------------------------------------------- Google (official Programmable Search API)
def google_cse(con, queries, max_calls=12):
    """Past-24h Google results for ATS-hosted postings via Google's official Custom Search JSON API.
    Needs GOOGLE_CSE_KEY + GOOGLE_CSE_CX in .env (100 free queries/day). Registers every ATS board found,
    so the board's full posting list is pulled through its public API. Returns number of new boards."""
    import os
    key, cx = os.getenv("GOOGLE_CSE_KEY"), os.getenv("GOOGLE_CSE_CX")
    if not (key and cx): return 0
    new = calls = 0
    for q in queries:
        for start in (1, 11):
            if calls >= max_calls: return new
            calls += 1
            r = S.get("https://www.googleapis.com/customsearch/v1", params={"key": key, "cx": cx, "q": q, "dateRestrict": "d2", "num": 10, "start": start}, timeout=25)
            if r.status_code != 200:
                log(f"google CSE error {r.status_code}: {r.text[:100]}", "WARN"); return new
            for it in r.json().get("items", []):
                b = board_from_url(it.get("link", ""))
                if b and register_board(con, *b): new += 1
    return new

def serper_search(con, queries, max_calls=20):
    """Past-2-days Google results (India) via Serper.dev (needs SERPER_KEY in .env; 2,500 free searches).
    Registers every ATS board found so its full posting list is pulled through the board's public API.
    Replaces google_cse (Google closed the Custom Search JSON API to new projects). Returns number of new boards."""
    import os
    key = os.getenv("SERPER_KEY")
    if not key: return 0
    new = calls = 0
    for q in queries:
        for page in (1, 2):
            if calls >= max_calls: return new
            calls += 1
            r = S.post("https://google.serper.dev/search", headers={"X-API-KEY": key, "Content-Type": "application/json"},
                       json={"q": q, "num": 10, "page": page, "gl": "in", "hl": "en", "tbs": "qdr:d2"}, timeout=25)
            if r.status_code != 200:
                log(f"serper error {r.status_code}: {r.text[:100]}", "WARN"); return new
            for it in r.json().get("organic", []):
                b = board_from_url(it.get("link", ""))
                if b and register_board(con, *b): new += 1
    return new

NOT_CAREER_PAGE = re.compile(r"linkedin|naukri|indeed|glassdoor|foundit|monster|shine\.com|timesjobs|instahyre|cutshort|wellfound|angel\.co|ziprecruiter|simplyhired|jooble|careerjet|talent\.com|hirist|iimjobs|apna\.co|internshala|freshersworld|jobsora|learn4good|google\.|facebook|youtube|reddit|quora|medium\.com|twitter|x\.com|instagram|wikipedia|ambitionbox|payscale|salary\.com|jobrapido|adzuna|whatjobs|jobtensor|builtin|dice\.com|remoteok|weworkremotely|himalayas|simplify\.jobs|jobgether|ycombinator|threads\.(com|net)|icims|taleo|myworkday", re.I)

def career_pages(queries, max_calls=8):
    """Company career-page postings (banks, NBFCs, fintechs, anyone) found through Serper.dev, past week, India.
    ATS-hosted links are skipped here (serper_search registers those boards instead); job boards that need a login are skipped.
    Returns job dicts with ats='other' (the generic form filler then tries them; login/CAPTCHA pages end up needs_manual/captcha)."""
    import os
    key = os.getenv("SERPER_KEY")
    if not key: return []
    out, seen, calls = [], set(), 0
    for q in queries:
        if calls >= max_calls: break
        calls += 1
        r = S.post("https://google.serper.dev/search", headers={"X-API-KEY": key, "Content-Type": "application/json"},
                   json={"q": q, "num": 10, "gl": "in", "hl": "en", "tbs": "qdr:w"}, timeout=25)
        if r.status_code != 200:
            log(f"serper career search error {r.status_code}: {r.text[:100]}", "WARN"); break
        for it in r.json().get("organic", []):
            link = it.get("link", ""); host = urlparse(link).netloc.lower()
            if not link.startswith("http") or link in seen or NOT_CAREER_PAGE.search(host) or board_from_url(link): continue
            seen.add(link)
            title = re.split(r"\s[|\u2013\u2014]\s|\s-\s(?=[A-Z][^-]*(careers?|jobs?)\b)", it.get("title", ""))[0].strip()
            labels = [p for p in host.replace("www.", "").split(".") if p not in ("com", "in", "co", "org", "net", "io", "careers", "jobs", "career", "apply")]
            company = (labels[-1] if labels else host).replace("-", " ").title()
            out.append(_mk("career-page", company, title, "India", link, link, it.get("snippet", ""), it.get("date", "")))
    log(f"career pages (Serper): {len(out)} postings")
    return out
